# Токен вашего Telegram бота (получите у @BotFather)
TELEGRAM_BOT_TOKEN=

# Список разрешенных Telegram User ID через запятую (узнайте свой ID через @userinfobot)
# Например: 123456789,987654321
ALLOWED_USERS=

# Путь к исполняемому файлу agy.exe (если в PATH, можно оставить просто agy)
AGY_PATH=C:\Users\Chatty\AppData\Local\agy\bin\agy.exe

# Рабочая папка по умолчанию, в которой агент будет запускать команды и искать файлы
DEFAULT_WORKING_DIR=C:\Users\Chatty\Projects

# Модель по умолчанию (gemini-3.8-flash-high, gemini-3.1-pro-high, claude-sonnet-4-6 и др.)
DEFAULT_MODEL=gemini-3.8-flash-high

# Авто-подтверждение прав на запуск команд и редактирование файлов (true/false)
AUTO_APPROVE=true
